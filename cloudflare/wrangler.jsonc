{
  // burstel: Worker + one ShotDO (SQLite-backed) + one Container per shot,
  // freezing the DuckDB artifact into R2. A singleton SQLite-backed IngestDO
  // coordinates per-shot push-only ingest tokens (token -> shot), the shot
  // registry and the concurrent-recording cap (spec 013, Part A). A singleton
  // SQLite-backed AuthDO holds the per-person token registry (spec 013, Part B).
  //
  // The Container uses the well-supported `default` scheduling policy: the image
  // and instance size live here in Wrangler configuration, and the ShotDO starts
  // the container process at runtime through the Durable Object Container API
  // (`this.ctx.container`).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "burstel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  // Required so `request.signal` reaches a Durable Object `fetch` handler; used
  // to stop forwarding ingest bodies when the client disconnects.
  "compatibility_flags": ["enable_request_signal"],

  // Spec 014: named instances with push-only tokens. There is no
  // application-level concurrent-recording cap; backend capacity is bounded by
  // the container `max_instances` control below.
  //
  // Spec 018 compaction knobs. GC is OFF by default: the compactor always
  // publishes verified segments, but it only deletes covered raw journal data
  // when COMPACTION_GC is explicitly enabled.
  "vars": {
    "MAX_INGEST_BYTES": "8388608",
    // Spec 023 D2.2 / spec 031 D4: late-write guard. Slower PUTs still get a
    // retryable 503, but shot materialization starts at end + this limit.
    "LATE_WRITE_LIMIT_MS": "10000",
    "COMPACTION_WINDOW_MS": "60000",
    "COMPACTION_GRACE_MS": "90000",
    // Spec 023 D3.1: every run re-lists this lookback (>= 2 x grace).
    "COMPACTION_LOOKBACK_MS": "180000",
    "COMPACTION_RETENTION_MS": "86400000",
    // Spec 024 R5: revoked-token journal objects stay in place for audit for
    // 7 days, excluded from every segment, before deletion.
    "COMPACTION_REVOKED_RETENTION_MS": "604800000",
    "COMPACTION_GC": "0",
    // Spec 029: one build + download must finish comfortably inside the
    // Worker -> Container request limits. 8 MiB is ~75 x 111 KiB journal
    // objects; 256 bounds the count for unusually small objects.
    "COMPACTION_BATCH_OBJECTS": "256",
    "COMPACTION_BATCH_BYTES": "8388608",
    "COMPACTION_MAX_BATCHES": "4",
    "COMPACTION_TICK_BUDGET_MS": "600000",
    "COMPACTION_SCHEDULE_MS": "120000",
    "COMPACTION_LEASE_TTL_MS": "900000",
    // Spec 029: explicit CompactorCore -> container request deadline.
    "COMPACTION_CONTAINER_TIMEOUT_MS": "60000",
    // Spec 033: fixed materializer pool `materializer-0..P-1`. P must stay at
    // least one below the CompactorDO max_instances (4) so continuous
    // compaction always has a container slot.
    "MATERIALIZE_PARALLELISM": "3",
    "MATERIALIZE_MAX_INSTANCES": "4",
    "MATERIALIZE_WAIT_MS": "90000",
    "MATERIALIZE_MAX_OBJECTS": "200000",
    // Spec 032: the coordinator DO alarm owns the run. Parts have a lease and
    // a bounded attempt count, so a lost alarm/container cannot wedge `running`.
    "MATERIALIZE_MAX_ATTEMPTS": "3",
    "MATERIALIZE_LEASE_TTL_MS": "300000",
    "MATERIALIZE_RETRY_MS": "5000",
    "MATERIALIZE_HEARTBEAT_MS": "30000",
    // Spec 033: keep a finished pool member warm for the next shot, and back
    // off (without burning an attempt) when the platform has no free instance.
    "MATERIALIZE_KEEPALIVE_MS": "600000",
    "MATERIALIZE_CAPACITY_BACKOFF_MS": "10000",
    // Spec 033: split into 2x pool parts so a freed member immediately takes a
    // queued part (and R2 GET concurrency doubles).
    "MATERIALIZE_PARTS_PER_MEMBER": "2",
    // Spec 034: size parts by *estimated spans*, not bytes. 500k spans keeps a
    // part inside the build budget; ~40 spans/KiB is the measured staging ratio
    // (196 MB gzip -> ~8.0M spans).
    "MATERIALIZE_PART_TARGET_SPANS": "500000",
    "MATERIALIZE_SPANS_PER_KIB": "40",
    // Spec 034: projection-only parts have their own 1 GiB ceiling (the old
    // 256 MiB segment limit no longer applies), and the part request timeout
    // scales from 120 s by 500 ms per MiB of input up to 10 min.
    "MATERIALIZE_MAX_PART_BYTES": "1073741824",
    "MATERIALIZE_PART_TIMEOUT_MS": "120000",
    "MATERIALIZE_PART_TIMEOUT_PER_MIB_MS": "500",
    "MATERIALIZE_MAX_PART_TIMEOUT_MS": "600000",
    // Spec 034: parallel pipeline defaults (container-side).
    "MATERIALIZE_CONCURRENCY": "32",
    // Spec 031 D1: the bucket whose scoped token is injected into the
    // compactor/materializer container. The credential itself is a Worker secret.
    "R2_BUCKET_NAME": "burstel-shots"
  },

  "containers": [
    {
      "class_name": "ShotDO",
      "scheduling_policy": "default",
      // Build the existing Phase 1 Go recorder image. The build context is the
      // repository root so the Dockerfile can `COPY` the Go sources.
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      // A limited number of concurrent Container instances; exceeding this is
      // surfaced to clients as a retryable capacity error.
      "max_instances": 10
    },
    {
      // Spec 018: the short-lived, bounded compactor service. It is a distinct
      // class so it never shares storage, image or lifecycle with ShotDO.
      "class_name": "CompactorDO",
      "scheduling_policy": "default",
      "image": "../Dockerfile.compactor",
      "image_build_context": "..",
      // Spec 034 R2: the materializer containers build projection-only parts
      // with a parallel appender pipeline. `standard-4` (4 vCPU / 8 GiB) is the
      // documented cost/throughput choice; ShotDO stays on `standard-1`.
      "instance_type": "standard-4",
      // Spec 031: up to four parallel materializer containers per shot. The
      // fenced lease still enforces a single active *compaction* per partition.
      "max_instances": 4
    }
  ],

  // Spec 024 R1: the exported storage class keeps the legacy `IngestDO` name.
  // The code-level alias `ControlDO` is not a deployable class name: a rename
  // would need a `renamed_classes` migration, which the `exports` style cannot
  // declare. Keeping the name preserves all existing DO SQLite state.
  "durable_objects": {
    "bindings": [
      {
        "name": "SHOT_DO",
        "class_name": "ShotDO"
      },
      {
        "name": "INGEST_DO",
        "class_name": "IngestDO"
      },
      {
        "name": "AUTH_DO",
        "class_name": "AuthDO"
      },
      {
        "name": "COMPACTOR_DO",
        "class_name": "CompactorDO"
      },
      {
        // Spec 032: per-shot alarm-driven materialization coordinator.
        "name": "MATERIALIZE_DO",
        "class_name": "MaterializeDO"
      }
    ]
  },

  "exports": {
    "ShotDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "IngestDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AuthDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CompactorDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MaterializeDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  // Spec 018: Cron backstop. The CompactorDO's own alarm is the primary
  // scheduler; this kicks a bounded tick so a lost alarm cannot stall
  // compaction. Overlapping triggers are safe (fenced lease).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Spec 023 D1: instance-token admission cache. Key `sha256(token)`, positive
  // entries only; deleted on revoke/rotate.
  "kv_namespaces": [
    {
      "binding": "INSTANCE_TOKENS",
      "id": "00000000000000000000000000000000"
    }
  ],

  // Spec 023 D2: ledger-free ingest counters (accepted/rejected/bytes/recency).
  "analytics_engine_datasets": [
    {
      "binding": "INGEST_ANALYTICS",
      "dataset": "burstel_ingest"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      // Created by a distinct, authorized deployment job. This repo never
      // creates buckets or writes account credentials.
      "bucket_name": "burstel-shots"
    }
  ],

  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
