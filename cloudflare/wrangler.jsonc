{
  // burstel: Worker + one ShotDO (SQLite-backed) + one Container per shot,
  // freezing the DuckDB artifact into R2. A singleton SQLite-backed IngestDO
  // coordinates per-shot push-only ingest tokens (token -> shot), the shot
  // registry and the concurrent-recording cap (spec 013, Part A). A singleton
  // SQLite-backed AuthDO holds the per-person token registry (spec 013, Part B).
  //
  // The Container uses the well-supported `default` scheduling policy: the image
  // and instance size live here in Wrangler configuration, and the ShotDO starts
  // the container process at runtime through the Durable Object Container API
  // (`this.ctx.container`).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "burstel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  // Required so `request.signal` reaches a Durable Object `fetch` handler; used
  // to stop forwarding ingest bodies when the client disconnects.
  "compatibility_flags": ["enable_request_signal"],

  // Spec 014: named instances with push-only tokens. There is no
  // application-level concurrent-recording cap; backend capacity is bounded by
  // the container `max_instances` control below.
  //
  // Spec 018 compaction knobs. GC is OFF by default: the compactor always
  // publishes verified segments, but it only deletes covered raw journal data
  // when COMPACTION_GC is explicitly enabled.
  "vars": {
    "MAX_INGEST_BYTES": "8388608",
    "COMPACTION_WINDOW_MS": "60000",
    "COMPACTION_GRACE_MS": "90000",
    "COMPACTION_RETENTION_MS": "86400000",
    "COMPACTION_GC": "0",
    "COMPACTION_BATCH_OBJECTS": "2048",
    "COMPACTION_BATCH_BYTES": "33554432",
    "COMPACTION_MAX_BATCHES": "4",
    "COMPACTION_TICK_BUDGET_MS": "600000",
    "COMPACTION_SCHEDULE_MS": "120000",
    "COMPACTION_LEASE_TTL_MS": "900000"
  },

  "containers": [
    {
      "class_name": "ShotDO",
      "scheduling_policy": "default",
      // Build the existing Phase 1 Go recorder image. The build context is the
      // repository root so the Dockerfile can `COPY` the Go sources.
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      // A limited number of concurrent Container instances; exceeding this is
      // surfaced to clients as a retryable capacity error.
      "max_instances": 10
    },
    {
      // Spec 018: the short-lived, bounded compactor service. It is a distinct
      // class so it never shares storage, image or lifecycle with ShotDO.
      "class_name": "CompactorDO",
      "scheduling_policy": "default",
      "image": "../Dockerfile.compactor",
      "image_build_context": "..",
      "instance_type": "standard-1",
      // At most one active compactor instance; the fenced lease enforces a
      // single active compaction per partition regardless.
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "SHOT_DO",
        "class_name": "ShotDO"
      },
      {
        "name": "INGEST_DO",
        "class_name": "IngestDO"
      },
      {
        "name": "AUTH_DO",
        "class_name": "AuthDO"
      },
      {
        "name": "COMPACTOR_DO",
        "class_name": "CompactorDO"
      }
    ]
  },

  "exports": {
    "ShotDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "IngestDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AuthDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CompactorDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  // Spec 018: Cron backstop. The CompactorDO's own alarm is the primary
  // scheduler; this kicks a bounded tick so a lost alarm cannot stall
  // compaction. Overlapping triggers are safe (fenced lease).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "r2_buckets": [
    {
      "binding": "BUCKET",
      // Created by a distinct, authorized deployment job. This repo never
      // creates buckets or writes account credentials.
      "bucket_name": "burstel-shots"
    }
  ],

  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
